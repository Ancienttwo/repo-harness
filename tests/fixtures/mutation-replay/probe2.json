["git commit -m \"$(cat <<'EOF'\nfix(hook): map a -> b\nEOF\n)\"","gh pr create --title x --body \"$(cat <<'EOF'\n## Summary\n- run node scripts\n- don't rm it\nEOF\n)\"","git commit -m \"use `node` for the cp step\"","ls $(pwd) | grep x > /tmp/out.txt","echo \"$(rm -rf _ops)\"","x=$(cd _ops && rm -rf env)","echo `echo x > _ops/x`","X=$(pwd) git worktree add ../x","FOO=1 git worktree add ../x","X=1 rm -rf _ops","echo $(date) > report.txt","git worktree add \"$(mktemp -d)\"","echo \"$(case x in a) rm -rf _ops;; esac)\"","echo \"$(echo \" ; rm -rf _ops ; echo \")\"","cat <<EOF > notes.md\nDate: $(date)\nEOF","echo $(true) cd _ops && rm -rf env","echo $((1+2)) > y","echo \"${x:-a}\" > y","echo $(echo $(echo $(rm -rf _ref)))","cd src && echo \"$(cd .. && rm -rf _ops)\"","cd src && echo \"$(rm -rf ../_ops)\""]
