{
  "tasks": {
    "research_dir": "docs/researches"
  },
  "external_sources": {
    "version": 1,
    "mode": "off"
  },
  "operations": {},
  "context": {
    "map_file": ".ai/context/context-map.json",
    "capability_source": "archcontext"
  },
  "harness": {
    "runs_dir": ".ai/harness/runs"
  },
  "information_lifecycle": {
    "external_knowledge": {
      "project_path": "brain/repo-harness/*",
      "manifest_file": ".ai/harness/brain-manifest.json",
      "sync_script": "repo-harness brain sync"
    }
  },
  "documentation": {
    "language": "en"
  },
  "worktree_strategy": {
    "branch_prefix": "codex/",
    "base_branch": "main",
    "review_base": "origin/main",
    "merge_back": {
      "target": "main"
    }
  },
  "publication": {
    "acceptance_merge": "on"
  },
  "tooling": {
    "codegraph": {
      "enabled": true
    }
  },
  "external_tooling": {
    "agent_fleet": {
      "managed_agents": [
        "explorer",
        "deep-reasoner",
        "fast-worker",
        "deep-worker",
        "gatekeeper",
        "root-cause-prover",
        "harness-evaluator"
      ],
      "install_mode": "auto-install-on-init"
    }
  },
  "internal_pr_authors": []
}
